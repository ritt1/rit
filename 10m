char m[]="Hello I'm Arduino-2\n",r[30];

void setup(){
  Serial.begin(9600);
  pinMode(10,INPUT);
}

void loop(){

  if(digitalRead(10)){
    if(Serial.available()){
      int n=Serial.readBytes(r,30);
      r[n]=0;
      Serial.println(r);
    }
  }
  else{
    Serial.print(m);
    delay(1000);
  }
}
