#include <Adafruit_LiquidCrystal.h>
#include <Keypad.h>

Adafruit_LiquidCrystal l1(0x20),l2(0x21);

char k[4][4]={{'1','2','3','A'},{'4','5','6','B'},{'7','8','9','C'},{'*','0','#','D'}};
byte r[4]={9,8,7,6},c[4]={5,4,3,2};

Keypad kp=Keypad(makeKeymap(k),r,c,4,4);

int n;

void setup(){
  l1.begin(16,2); l2.begin(16,2);
  l1.print("Total Key Press:"); l2.print("Enter Key Value:");
}

void loop(){
  char x=kp.getKey();
  if(x){
    l2.setCursor(4,1); l2.print(x);
    l1.setCursor(0,1); l1.print(++n);
  }
}
