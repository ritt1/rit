void setup(){
  pinMode(9,1); pinMode(10,0);
  pinMode(2,1); pinMode(3,1); pinMode(4,1);
}

void loop(){
  digitalWrite(9,1); delayMicroseconds(10); digitalWrite(9,0);
  int d=pulseIn(10,1)/58;

  digitalWrite(2,d<50);
  digitalWrite(3,d>=50 && d<120);
  digitalWrite(4,d>=120 && d<200);

  if(d>=200) digitalWrite(2,1),digitalWrite(3,1),digitalWrite(4,1);

  delay(100);
}
