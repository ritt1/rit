#include <mpi.h>
#include <stdio.h>

int main(int argc, char *argv[]) 
{
 int rank, size;
 int send_data[4], recv_data, gathered_data[4];

 MPI_Init(&argc, &argv);
 MPI_Comm_rank(MPI_COMM_WORLD, &rank);
 MPI_Comm_size(MPI_COMM_WORLD, &size);

 if (size != 4) 
{
 if (rank == 0) 
{
 printf("Please run this program with 4 processes.\n");
}
 MPI_Finalize();
 return 0;
 }

 if (rank == 0) 
{
 send_data[0] = 10;
 send_data[1] = 20;
 send_data[2] = 30;
 send_data[3] = 40;
 printf("Root process sending data: 10, 20, 30, 40\n");
 }

 MPI_Scatter(send_data, 1, MPI_INT, &recv_data, 1, MPI_INT, 0, MPI_COMM_WORLD);

 printf("Process %d received data = %d\n", rank, recv_data);

 recv_data += 1;

 MPI_Gather(&recv_data, 1, MPI_INT, gathered_data, 1, MPI_INT, 0, MPI_COMM_WORLD);

 if (rank == 0) {
 printf("Root process gathered data: ");
 for (int i = 0; i < 4; i++) {
 printf("%d ", gathered_data[i]);
 }
 printf("\n");
 }

 MPI_Finalize();

 return 0;
}
